# Copy this file to ".env" (in the same folder) and fill in your own values.
# .env is ignored by Git, so your API key stays on your machine.

# The folder that holds your film files. Start with the test films; later point it
# at your real folder, e.g. D:/Films (forward slashes work fine on Windows).
MOVIE_LIBRARY_PATH=../sample_films

# Where the SQLite database file is stored (relative to the backend folder)
DATABASE_PATH=data/library.db

# Your TMDB API key (needed from stage 3). Get one at themoviedb.org -> Settings -> API
TMDB_API_KEY=
